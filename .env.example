# ==============================================================================
# Conversation-to-Ship Web Platform — Sanitized Environment Template
# Copy to .env (never commit .env). All runtime secrets remain out of git.
# ==============================================================================

# --- Core Web App & Auth ---
APP_BASE_URL=https://app.example.com
SESSION_SECRET=replace-with-random-32-byte-hex
# Keep real admin email only in Cloudflare Worker secret (`wrangler secret put ADMIN_EMAIL`)
ADMIN_EMAIL=admin@example.com

# --- GitHub OAuth & Product Repo Provisioning ---
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY_PEM=replace-with-multiline-or-secret-store-ref
DEFAULT_GITHUB_OWNER=your-github-org-or-user
DEFAULT_PRODUCT_REPO_VISIBILITY=private
DEFAULT_JOINER_REPO_ROLE=push

# --- Swappable Booking / Calendar / Call / Transcript Providers ---
PROVIDER_CONFIG_PATH=config/providers.yaml

# Calendly (Paid webhook + API)
CALENDLY_API_TOKEN=replace-with-calendly-pat
CALENDLY_WEBHOOK_SIGNING_KEY=replace-with-calendly-signing-key

# Google Workspace (Calendar Push Watch + Meet Conference Records + Drive Transcripts)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALENDAR_WEBHOOK_TOKEN=replace-with-random-channel-token
GOOGLE_MEET_SCOPES=https://www.googleapis.com/auth/meetings.space.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/drive.readonly

# Read.ai (Webhook + MCP/API fallback)
READAI_API_TOKEN=replace-with-readai-token
READAI_WEBHOOK_SECRET=replace-with-readai-webhook-secret
READAI_MCP_URL=https://api.read.ai/mcp

# --- Cloudflare Workers, D1/Postgres & R2 Storage ---
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_R2_BUCKET=conversation-to-ship-artifacts
CLOUDFLARE_R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_WORKERS_DEPLOY_DOMAIN=workers.dev

# --- Local Antigravity CLI (agy) Bridge Worker ---
BRIDGE_WORKER_TOKEN=replace-with-random-bridge-secret
BRIDGE_LOCAL_WORKSPACE_ROOT=./workspaces
BRIDGE_TERMINAL_LAUNCHER=wt

# --- Weekly Model Matrix Reference ---
MODEL_MATRIX_PATH=modules/model-matrix/routing.json
MODEL_MATRIX_PAGES_URL=https://maximusmaximus.github.io/agentic-model-matrix/routing.json
MODEL_MATRIX_STATS_URL=https://maximusmaximus.github.io/agentic-model-matrix/stats.json
MODEL_MATRIX_LLMS_URL=https://maximusmaximus.github.io/agentic-model-matrix/llms.txt
MODEL_MATRIX_SCHEMA_URL=https://maximusmaximus.github.io/agentic-model-matrix/schema/routing.schema.json
MODEL_MATRIX_RAW_URL=https://raw.githubusercontent.com/maximusmaximus/agentic-model-matrix/main/routing.json
